# Pré-produção, Etapa 2 (seção 15) — checklist de deploy pra produção,
# nunca hardcodar domínio/segredo real aqui, isto é só o TEMPLATE:
# - APP_ENV=production (nunca "local"/"testing" em produção)
# - APP_DEBUG=false (OBRIGATÓRIO — com true, qualquer exceção não tratada
#   expõe stack trace completo + variáveis de ambiente na tela pro
#   visitante; ver auditoria da Etapa 1, seção 22)
# - APP_URL=https://<domínio real de produção> (precisa bater com o
#   domínio servido de verdade — usado, entre outras coisas, pra resolver
#   Sanctum::currentApplicationUrlWithPort() em config/sanctum.php)
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Fixa o nome do projeto docker compose independente do shell/caminho de
# onde o Sail for chamado — evita subir um segundo conjunto de containers
# com nome em hash e brigar pelas mesmas portas.
COMPOSE_PROJECT_NAME=dcf_eng

# Sail/Docker — UID/GID do usuário `sail` DENTRO do container, usados por
# `docker-compose.yml` (build arg do Dockerfile + env de todos os
# serviços) pra criar esse usuário com o MESMO UID/GID do seu usuário no
# HOST. Sem isso, `docker compose build` falha (GID vazio no
# `groupadd`) e qualquer diretório que o container crie em runtime
# (ex.: cache compilado do Livewire em storage/framework/views/livewire)
# pode ficar com dono incompatível entre host e container — mesma classe
# de bug já documentada no projeto (achado real, 2026-09-02: `tempnam():
# file created in the system's temporary directory`, causa raiz era
# exatamente esse tipo de mismatch de ownership). Ajuste pra bater com a
# saída de `id -u`/`id -g` da SUA máquina se for diferente de 1000 (o
# valor default pra todo primeiro usuário comum em Linux/macOS/WSL2).
WWWUSER=1000
WWWGROUP=1000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Monitoramento de erro em produção (Sentry) — vazio = desabilitado, sem
# erro nenhum; preencher só em produção com o DSN do projeto no Sentry.
SENTRY_LARAVEL_DSN=

# WhatsApp (Z-API) — vazio = canal 'whatsapp' das notificações não envia
# nada (App\Notifications\Channels\ZApiChannel ignora silenciosamente).
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Cobrança (Mercado Pago) — vazio = App\Services\MercadoPagoGateway lança
# exceção ao ser chamado (nunca silencioso, diferente do Z-API, porque
# criar uma cobrança que nunca chega ao gateway não pode falhar em
# silêncio). MERCADOPAGO_PUBLIC_KEY é o único valor exposto no navegador
# (Card Payment Brick), nunca o access_token.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MIX_REVERB_APP_KEY="${REVERB_APP_KEY}"
MIX_REVERB_HOST="${REVERB_HOST}"
MIX_REVERB_PORT="${REVERB_PORT}"
MIX_REVERB_SCHEME="${REVERB_SCHEME}"
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false  # Definir como true em produção (HTTPS)
# SESSION_DOMAIN= (deixar vazio funciona pro host atual; só definir
#   explicitamente se a sessão precisar valer em subdomínios)
# SANCTUM_STATEFUL_DOMAINS= (só relevante se o middleware
#   EnsureFrontendRequestsAreStateful do Sanctum for ativado no futuro —
#   hoje está comentado no grupo 'api' do Kernel, não em uso)
#
# TrustProxies (Pré-produção, Etapa 2, seção 15) — se em produção houver
# QUALQUER reverse proxy/load balancer/CDN na frente da aplicação
# (Nginx terminando TLS, Cloudflare etc.), App\Http\Middleware\TrustProxies
# PRECISA declarar esse proxy como confiável (propriedade $proxies), senão
# a aplicação nunca detecta HTTPS via X-Forwarded-Proto — isso não tem
# variável de .env própria (é hardcoded na classe, de propósito, pra não
# aceitar qualquer IP via env por engano); documentado aqui só como
# lembrete de checklist antes de colocar um proxy na frente do app.

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
